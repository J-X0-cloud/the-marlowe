# Where submissions are delivered. Unset in development: payloads are logged instead.
FRONT_DESK_WEBHOOK_URL=
TABLES_WEBHOOK_URL=
EVENTS_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
